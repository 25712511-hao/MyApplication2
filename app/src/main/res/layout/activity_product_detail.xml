<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <ImageView
        android:id="@+id/imgProductBanner"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:scaleType="centerCrop"
        android:background="@color/surface_bg"
        android:contentDescription="Ảnh minh họa sản phẩm" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tai Nghe Không Dây Chống Ồn Chủ Động Cao Cấp Pro Max 2026"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2.890.000 VNĐ"
            android:textColor="@color/primary_blue"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtProductDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Trải nghiệm chất âm chân thực với công nghệ lọc ồn kỹ thuật số thế hệ mới, thời lượng pin sử dụng liên tục lên đến 40 giờ kèm hộp sạc hỗ trợ sạc nhanh Type-C."
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Chọn kích cỡ:"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgProductSizes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbSizeM"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Thường"
                android:checked="true"
                android:buttonTint="@color/primary_blue" />

            <RadioButton
                android:id="@+id/rbSizeL"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nâng Cao"
                android:buttonTint="@color/primary_blue" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/chkWarranty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Gói bảo hành vàng đổi mới trong 12 tháng (+150.000đ)"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:buttonTint="@color/primary_blue"
            android:checked="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="22dp"
            android:text="THÊM VÀO GIỎ HÀNG"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="12dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            android:elevation="5dp" />

    </LinearLayout>

</LinearLayout>
